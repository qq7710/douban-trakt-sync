[Unit]
Description=Douban wishlist -> Trakt watchlist (near realtime watcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成你实际的项目目录和 python 路径
WorkingDirectory=/opt/douban-trakt-sync
ExecStart=/opt/douban-trakt-sync/.venv/bin/python /opt/douban-trakt-sync/sync.py watch
Restart=always
RestartSec=10
StandardOutput=append:/opt/douban-trakt-sync/watch.log
StandardError=append:/opt/douban-trakt-sync/watch.log

[Install]
WantedBy=multi-user.target
